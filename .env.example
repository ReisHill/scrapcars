# Export these variables in your terminal or set them in Cloudflare build settings.
# This file is documentation; scripts do not automatically load .env files.
SITE_ORIGIN=http://localhost:3000
SITE_INDEXABLE=false
# Optional local server controls:
HOST=127.0.0.1
PORT=3000
# Optional Python executable override:
# PYTHON=python3
# Live build only after config/site.json and delivery are confirmed:
SITE_LIVE=false
# Worker runtime variables are configured separately in Cloudflare, not here:
# PUBLIC_ORIGIN=https://your-chosen-domain.co.uk
# QUOTE_DELIVERY_ENABLED=false
# QUOTE_TO=your-business-inbox
# QUOTE_FROM=verified-sender-on-your-domain
# RESEND_API_KEY is a Cloudflare secret. Never commit it.
