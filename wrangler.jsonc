{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "scrapcars",
  "compatibility_date": "2026-10-25",
  "workers_dev": true,
  "assets": {
    "directory": "./dist",
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api/*"
    ]
  },
  "main": "worker/index.mjs",
  "ratelimits": [
    {
      "name": "QUOTE_RATE_LIMITER",
      "namespace_id": "104726",
      "simple": {
        "limit": 5,
        "period": 60
      }
    }
  ],
  "keep_vars": true
}
